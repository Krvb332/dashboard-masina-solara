{
  "buildCommand": "tsc -b && VITE_STATIC_REPLAY=1 vite build --base=/",
  "rewrites": [
    { "source": "/api/v1/signals", "destination": "/data/signals.json" },
    { "source": "/api/v1/sessions", "destination": "/data/sessions.json" },
    {
      "source": "/api/v1/sessions/:id/alarms",
      "destination": "/data/alarms/:id.json"
    },
    {
      "source": "/api/v1/history",
      "has": [{ "type": "query", "key": "session_id", "value": "(?<id>\\d+)" }],
      "missing": [{ "type": "query", "key": "offset" }],
      "destination": "/data/history/:id.json"
    },
    { "source": "/api/v1/history", "destination": "/data/empty.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
