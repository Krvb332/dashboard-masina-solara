# URL-urile serviciului de telemetrie. Lasă-le goale pentru a rula pe simulator.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Sursa de date: websocket | simulator | auto (implicit)
# `auto` folosește WebSocket dacă VITE_WS_URL este setat, altfel simulatorul.
VITE_TELEMETRY_SOURCE=auto
