# Serviciul de telemetrie (server/).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Token de acces. Lasă gol în dezvoltare: serverul dezactivează verificarea
# atunci când nu are niciun token configurat. În pitlane, folosește tokenul de
# `operator` pe laptopul care controlează înregistrarea și pe cel de `viewer`
# pentru restul echipei.
VITE_API_TOKEN=

# --- Vreme și condiții meteo ---------------------------------------------
# Secțiunea meteo NU are nicio variabilă aici, și asta este intenționat.
#
# Tot ce începe cu `VITE_` este împachetat în fișierele livrate browserului;
# o cheie de furnizor pusă aici ar fi publică. Cheia meteo stă pe server, în
# `server/.env` (vezi `server/.env.example`), iar browserul primește doar
# rezultatul, prin `GET /api/v1/weather`.
