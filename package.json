{
  "name": "dashboard-masina-solara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:perf": "npm run bench && cd server && .venv/bin/python -m pytest tests/test_perf.py -q -m perf -s",
    "typecheck": "tsc -b --pretty false",
    "verify:signals": "node scripts/verify-signal-mapping.mjs",
    "verify:catalog": "node scripts/verify-catalog-additive.mjs",
    "verify:simulator": "node scripts/verify-simulator-coverage.mjs",
    "verify:plans": "node scripts/verify-plans.mjs",
    "verify:track": "node scripts/verify-track-reference.mjs --geometry && node scripts/verify-track-reference.mjs --elevation && node scripts/verify-track-reference.mjs --sync",
    "verify:track:sim": "node scripts/verify-track-reference.mjs --simulator",
    "verify": "npm run verify:signals && npm run verify:catalog && npm run verify:simulator && npm run verify:plans && npm run verify:track",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run verify:signals && npm run verify:catalog && npm run verify:track && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.101.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
