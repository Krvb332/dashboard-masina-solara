# Model pentru server/.env. Copiază-l și completează valorile reale.
#
#   cp server/.env.example server/.env
#
# server/.env este ignorat de git. Nu pune niciodată chei în acest fișier-model
# și nici într-o variabilă `VITE_*`: tot ce începe cu `VITE_` ajunge în textul
# livrat browserului, deci devine public în clipa în care cineva deschide
# DevTools. Cheia meteo trăiește doar aici, iar browserul primește doar
# rezultatul, prin `GET /api/v1/weather`.

# --- Stocare și ingest ----------------------------------------------------
# TELEMETRY_DB_PATH=data/telemetry.db
# TELEMETRY_MQTT_HOST=
# TELEMETRY_MQTT_PORT=1883
# TELEMETRY_MQTT_TOPIC=solar/+/telemetry

# --- Autentificare --------------------------------------------------------
# Goale = verificarea este dezactivată (util în dezvoltare).
# TELEMETRY_OPERATOR_TOKEN=
# TELEMETRY_VIEWER_TOKEN=

# --- Vreme și condiții meteo ---------------------------------------------
# Cheie Google Maps Platform cu „Weather API" activat în proiect.
# Restricționeaz-o pe IP-ul serverului și limiteaz-o la Weather API:
# o cheie fără restricții poate fi folosită de oricine o obține.
TELEMETRY_WEATHER_API_KEY=

# Coordonatele circuitului (Zolder, linia de start), folosite cât timp GPS-ul mașinii nu are fix.
# Fără ele, secțiunea meteo raportează „fără poziție" în loc să presupună una.
TELEMETRY_WEATHER_DEFAULT_LAT=50.9894
TELEMETRY_WEATHER_DEFAULT_LON=5.2564

# Cât timp o observație rămâne bună, în secunde. Vremea nu se schimbă în zece
# minute, iar fiecare apel către furnizor este facturat.
TELEMETRY_WEATHER_TTL_S=600

# Câte ore de prognoză se cer. 0 dezactivează prognoza, păstrând observația curentă.
TELEMETRY_WEATHER_FORECAST_HOURS=12

# Cât așteptăm furnizorul înainte să declarăm căderea, în secunde.
# TELEMETRY_WEATHER_TIMEOUT_S=8

# Limba descrierilor meteo și adresa furnizorului.
# TELEMETRY_WEATHER_LANGUAGE=ro
# TELEMETRY_WEATHER_BASE_URL=https://weather.googleapis.com/v1
